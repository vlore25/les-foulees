generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum Genre {
  MALE
  FEMALE
  OTHER
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique @db.VarChar(255)
  name               String
  genre              Genre               @default(OTHER)
  lastname           String
  profileImageUrl    String?
  birthdate          DateTime?
  phone              String?
  password           String
  address            String
  zipCode            String
  city               String
  emergencyName      String?
  emergencyLastName  String?
  emergencyPhone     String?
  showPhoneDirectory Boolean             @default(false)
  showEmailDirectory Boolean             @default(false)
  role               Role                @default(USER)
  status             Status              @default(ACTIVE)
  deactivatedAt      DateTime?
  eventRegistrations EventRegistration[]
  memberships        Membership[]
  payments           Payment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Invitation {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

enum Visibility {
  PRIVATE
  PUBLIC
}

enum EventType {
  TRAIL
  COURSE_ROUTE
  ENTRAINEMENT
  VIE_DU_CLUB
  SORTIE
  AUTRE
}

model Event {
  id             String              @id @default(cuid())
  title          String
  imgUrl         String
  description    String?
  dateStart      DateTime?
  dateEnd        DateTime?
  location       String
  distances      String[]
  meals          String[]
  accommodations String[]
  type           EventType
  isFeatured     Boolean             @default(false)
  visibility     Visibility          @default(PUBLIC)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  registrations  EventRegistration[]
}

model EventRegistration {
  id             String   @id @default(cuid())
  userId         String
  eventId        String
  distance       String?
  meals          String[]
  accommodations String[]
  carpooling     Boolean  @default(false)
  createdAt      DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}


model LegalDocs {
  id          String  @id @default(cuid())
  title       String?
  description String?
  Url         String?
}


model Season {
  id                    String       @id @default(cuid())
  name                  String       @unique
  startDate             DateTime
  endDate               DateTime
  isOpenForRegistration Boolean      @default(false)
  priceStandard         Float        @default(35.0)
  priceCouple           Float        @default(60.0)
  priceYoung            Float        @default(25.0)
  priceFfa              Float        @default(98.0)
  memberships           Membership[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

enum MembershipStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum MembershipType {
  INDIVIDUAL
  COUPLE
  YOUNG
  LICENSE_RUNNING
}

model Membership {
  id               String           @id @default(cuid())
  user             User             @relation(fields: [userId], references: [id])
  userId           String
  season           Season           @relation(fields: [seasonId], references: [id])
  seasonId         String
  ffaLicenseNumber String?
  previousClub     String?
  certificateUrl   String?
  status           MembershipStatus @default(PENDING)
  pendingReason    String?
  type             MembershipType   @default(INDIVIDUAL)
  paymentId        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  payment          Payment?         @relation(fields: [paymentId], references: [id])

  partnerId String?     @unique
  partner   Membership? @relation("CoupleMembership", fields: [partnerId], references: [id])
  partnerOf Membership? @relation("CoupleMembership")

  @@unique([userId, seasonId])
}


enum PaymentMethod {
  CHECK
  TRANSFER
  CASH
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Payment {
  id          String        @id @default(cuid())
  amount      Float
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  reference   String?
  date        DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id])
  userId      String
  memberships Membership[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model SiteConfig {
  id             String   @id @default("default")
  heroDesktopUrl String?
  heroMobileUrl  String?
  privacyPolicy  String?
  legalNotice    String?
  updatedAt      DateTime @updatedAt
}

model TrainingSchedule {
  id     String  @id @default(cuid())
  day    String
  hour   String
  place  String
  imgUrl String?
  order  Int     @default(0)
}
